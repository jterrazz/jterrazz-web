{
    "extends": "@jterrazz/typescript/tsconfig/next",
    "compilerOptions": {
        // Deltas over the preset, deliberate: modern target, bundler
        // resolution and react-jsx match what Next 16 actually does.
        "target": "ES2022",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "plugins": [{ "name": "next" }]
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": ["node_modules"]
}
